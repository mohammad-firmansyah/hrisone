{
  "name": "hrisone-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "bun --filter @hrisone/backend start:dev",
    "dev:gateway": "bun --filter @hrisone/gateway start:dev",
    "dev:frontend": "bun --filter @hrisone/frontend dev",
    "build": "bun --filter '*' build",
    "build:backend": "bun --filter @hrisone/backend build",
    "build:gateway": "bun --filter @hrisone/gateway build",
    "build:frontend": "bun --filter @hrisone/frontend build",
    "test": "bun --filter '*' test",
    "lint": "bun --filter '*' lint",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,md}\"",
    "typeorm": "bun --filter @hrisone/backend typeorm",
    "migration:run": "bun --filter @hrisone/backend migration:run",
    "migration:revert": "bun --filter @hrisone/backend migration:revert",
    "migration:show": "bun --filter @hrisone/backend migration:show"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "dependencies": {
    "react-router": "^8.4.0"
  }
}
